---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/site.css';
import Icon from '../components/Icon.astro';

interface Props { title?: string; description?: string; og?: string; canonical?: string; bare?: boolean; wide?: boolean; find?: boolean; home?: boolean }
const { title, description = 'A library of Latter-day Saint and Christian scholarship: public-domain books and the journals, searched together. Every result opens the exact page, and every quotation can be checked against it.', og = '/og/site.png', canonical, bare, wide, find = true, home } = Astro.props;
const fullTitle = title ? `${title} · Lectern` : 'Lectern: out of the best books, cited to the page';
// A page is built as <address>.html; its address has no extension.
const here = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const nav = [
  ['/library', 'Library'], ['/search', 'Search'], ['/check', 'Check'], ['/connect', 'Connect'],
];
const current = (href: string) => (here === href || here.startsWith(href + '/') ? 'page' : undefined);
const abs = (p: string) => new URL(p, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(canonical ?? here)} />
    <meta property="og:site_name" content="Lectern" />
    <meta property="og:title" content={title ?? 'Lectern'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={abs(canonical ?? here)} />
    <meta property="og:image" content={abs(og)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={abs(og)} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0d0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={home ? 'home' : undefined}>
    <header class="bar">
      <div class="wrap bar-in">
        <a class="wordmark" href="/">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path class="wm-desk" d="M2.75 8.25 10 4.75l7.25 3.5L10 11.25z" /><path class="wm-mark" d="M6.5 7.6 10 6l3.5 1.6L10 9.2z" /><path class="wm-stand" d="M10 11.25v6M6.75 17.25h6.5" /></svg>
          Lectern
        </a>
        <nav class="nav" aria-label="Site">
          {nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
        </nav>
        {find && (
          <form class="bar-find" action="/search" role="search">
            <Icon name="search" small />
            <input class="field" type="search" name="query" placeholder="Search" aria-label="Search the library" autocomplete="off" />
          </form>
        )}
        <details class="menu">
          <summary aria-label="Menu"><Icon name="menu" /></summary>
          <nav aria-label="Site">
            {nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <main style={wide ? '--page: 1500px' : undefined}><slot /></main>
    {!bare && (
      <footer class="foot">
        <div class="wrap foot-in">
          <a href="/about">About</a>
          <a href="/about#public-domain">Public domain</a>
          <a href="https://github.com/Noah-Airmet/lectern">GitHub</a>
          <a class="by" href="https://restorationcommons.org">Restoration Commons</a>
        </div>
      </footer>
    )}
    <script>
      // Copy: the control says so with the drawn check, or the word, on the press itself.
      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const button = target.closest<HTMLElement>('[data-copy]');
        if (button) {
          navigator.clipboard.writeText(button.dataset.copy!);
          const use = button.querySelector('use');
          const was = use ? use.getAttribute('href')! : button.textContent!;
          if (use) use.setAttribute('href', '/icons.svg#check');
          else button.textContent = 'Copied';
          setTimeout(() => (use ? use.setAttribute('href', was) : (button.textContent = was)), 1200);
        }
        // A menu closes on a press outside it.
        document.querySelectorAll<HTMLDetailsElement>('details.menu[open], details.contents[open], details.pop[open]').forEach((d) => {
          if (!d.contains(target)) d.removeAttribute('open');
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') document.querySelectorAll('details.menu[open], details.contents[open], details.pop[open]').forEach((d) => d.removeAttribute('open'));
        // "/" searches from anywhere.
        const field = document.querySelector<HTMLElement>('.composer textarea, .ask input, .bar-find input');
        if (event.key === '/' && field && !(event.target as HTMLElement).closest('input, textarea, select')) { event.preventDefault(); field.focus(); }
      });
    </script>
  </body>
</html>
