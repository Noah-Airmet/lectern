---
import Base from '../layouts/Base.astro';
import { mcpUrl } from '../lib/env';
import Icon from '../components/Icon.astro';
const site = Astro.site!.origin;
const mcp = mcpUrl(site);
const clients = [
  ['Claude Code', `claude mcp add --transport http lectern ${mcp}`],
  ['Claude.ai, ChatGPT, others', mcp],
];
const tools = [
  ['search', 'search(query, collection?, org?, date_from?, date_to?, doc?, mode?, sort?, limit?)', 'Ranked pages. Words are ANDed; "a phrase", prefix*, a NEAR/5 b and -exclude work. Filter by shelf (collection), publisher, year or one book. Every hit is a citation.'],
  ['fetch', 'fetch(id)', 'A book id returns its record and contents. A cite string returns the page, in full, with a link to its image.'],
  ['verify_quote', 'verify_quote(quote, cite?, doc?)', 'Whether the words are at the cited place. Five verdicts: exact and normalized pass; elsewhere, near_miss and not_found fail, with where the words really are or what the page says instead.'],
  ['check_answer', 'check_answer(text)', 'Audits a draft answer: every citation in it, the quotations attached to each, and how each one checked out.'],
];
const api = [
  ['GET', '/api/search?query=…', 'SearchResponse'],
  ['GET', '/api/doc/<ns>/<id>[/<version>]', 'DocumentCard'],
  ['GET', '/api/units/<ns>/<id>/<version>/<anchor>', 'UnitText[]'],
  ['POST', '/api/verify', 'QuoteCheck'],
  ['POST', '/api/check', 'AnswerAudit'],
];
---
<Base title="Connect" description="Connect an AI assistant to Lectern over MCP: search, fetch, verify_quote, check_answer. No key.">
  <div class="wrap">
    <header class="head">
      <h1 class="title">Connect an AI</h1>
      <p class="facts"><span>MCP over HTTP</span><span>4 tools</span><span>Read-only</span><span>No key</span></p>
    </header>

    <dl class="clients">
      {clients.map(([name, line]) => (
        <>
          <dt>{name}</dt>
          <dd><div class="codeline"><code tabindex="0">{line}</code><button class="ib" data-copy={line} aria-label={`Copy for ${name}`}><Icon name="copy" /></button></div></dd>
        </>
      ))}
    </dl>

    <section class="section">
      <h2 class="h2">An answer</h2>
      <figure class="transcript">
        <p class="ask">“Using only the Lectern library, what did Joseph Smith teach in the King Follett sermon about the intelligence of spirits? Quote him exactly, with a citation link, and check your quotations before answering.”</p>
        <blockquote class="prose">
          <p>In the King Follett sermon (April 1844), Joseph Smith taught that the intelligence of spirits is uncreated and eternal. He said that “The intelligence of spirits had no beginning, neither will it have an end” (<a class="link" href="/d/smith/history-of-the-church/r1/p2356?q=The%20intelligence%20of%20spirits%20had%20no%20beginning%2C%20neither%20will%20it%20have%20an%20end">History of the Church, p. 2356</a>), and that “Intelligence is eternal and exists upon a self-existent principle. It is a spirit from age to age and there is no creation about it” (<a class="link" href="/d/smith/history-of-the-church/r1/p2357">p. 2357</a>).</p>
          <p>… The “co-equal” wording is the bracketed reading in the 1902 Roberts edition, and Roberts’s note says it “should have been written ‘co-eternal’” (<a class="link" href="/d/smith/history-of-the-church/r1/p2611">p. 2611</a>).</p>
        </blockquote>
        <figcaption class="facts"><span>Claude Haiku 5.5 in Claude Code, with Lectern connected and nothing else</span><span>14 Nov 2026</span><span>Every quotation checked with verify_quote</span></figcaption>
      </figure>
    </section>

    <section class="section">
      <h2 class="h2">Tools</h2>
      <ul class="tools">
        {tools.map(([name, sig, what]) => (
          <li><h3><b>{name}</b>{sig.slice(name.length)}</h3><p>{what}</p></li>
        ))}
      </ul>
    </section>

    <section class="section">
      <h2 class="h2">A citation</h2>
      <div class="anatomy">
        <code>npnf2:04-select-works-and-letters</code><span>book</span>
        <code class="sep">/</code><span></span>
        <code>r1</code><span>scan</span>
        <code class="sep">/</code><span></span>
        <code>p65</code><span>page of the scan</span>
      </div>
      <div class="anatomy-more">
        <div class="codeline"><code tabindex="0">{site}/d/npnf2/04-select-works-and-letters/r1/p65</code><button class="ib" data-copy={`${site}/d/npnf2/04-select-works-and-letters/r1/p65`} aria-label="Copy link"><Icon name="copy" /></button></div>
      </div>
    </section>

    <section class="section">
      <h2 class="h2">HTTP</h2>
      <div class="scroll" tabindex="0" role="region" aria-label="Routes"><table class="table routes" style="max-width: 54rem">
        <tbody>{api.map(([m, route, model]) => <tr><td>{m}</td><td>{route}</td><td>{model}</td></tr>)}</tbody>
      </table></div>
      <p class="facts" style="margin-top: var(--s-4)"><a class="link" href="https://github.com/Noah-Airmet/safetypage/tree/main/schemas">JSON Schemas</a><a class="link" href="https://github.com/Noah-Airmet/safetypage/blob/main/docs/ARCHITECTURE.md">The engine's architecture</a></p>
    </section>
  </div>
</Base>
