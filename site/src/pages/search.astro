---
// Search: the composer (Search, or Check a paragraph's citations); the results come in under it.
import Base from '../layouts/Base.astro';
import Search from '../islands/Search.tsx';
import { libraryCounts } from '../lib/data';

const n = libraryCounts();
---
<Base title="Search" description="Search public-domain Latter-day Saint and Christian scholarship to the page." find={false}>
  <div class="wrap searchroom">
    <h1 class="sr">Search</h1>
    <Search client:load documents={n.documents} />
  </div>
</Base>
