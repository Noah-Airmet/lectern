---
// Home: one screen, nothing scrolls, as on the Gospel Scholar Archives' home. The headline, the
// composer, and the wall of books filling the rest of the window and running off its bottom
// edge, with the Field behind it all. A search opens the search page.
import Base from '../layouts/Base.astro';
import Search from '../islands/Search.tsx';
import { getDoc, libraryCounts, shelfEntry } from '../lib/data';
import { citePath, clothOf, titleParts } from '../lib/cite';
import { BOUND, WALL, wallFile } from '../lib/wall';
import fs from 'node:fs';

const n = libraryCounts();
const scanned = WALL.map((id) => getDoc(id)).filter((d) => d && fs.existsSync(`public${wallFile(d.doc_id)}`))
  .map((d) => ({ href: citePath(d!.doc_id), title: d!.title, src: wallFile(d!.doc_id) }));
// A drawn binding carries the title, and under it the volume of a set or the author.
const bound = BOUND.map(([id, short]) => [getDoc(id), short] as const).filter(([d]) => d).map(([d, short]) => {
  const entry = shelfEntry(d!.doc_id);
  const main = short ?? titleParts(d!.title).main.replace(/, Volume \d+$/, '');
  const sub = entry?.volume ? `Volume ${entry.volume}` : (d!.authors[0] ?? '').replace(/\s*\(.*\)$/, '');
  return { href: citePath(d!.doc_id), title: d!.title, bind: { title: main, sub, cloth: clothOf(d!.collection ?? '') } };
});
---
<Base home bare find={false}>
  <canvas id="field" aria-hidden="true"></canvas>
  <div class="home-in">
    <section class="hero" id="hero">
      <h1>The Lectern</h1>
      <Search client:load documents={n.documents} home />
      <p class="hero-connect">Use Lectern in Claude or ChatGPT. <a href="/connect">Add the connector</a></p>
    </section>
    <div class="wall" id="wall" data-wall={JSON.stringify([...scanned, ...bound])}><div class="wbacks" aria-hidden="true"></div><div class="wtrack"></div></div>
  </div>
</Base>

<script>
  import '../scripts/wall.ts';
  import { startField } from '../scripts/field.js';
  const hero = document.getElementById('hero')!;
  startField({
    canvas: document.getElementById('field'),
    calm: () => { const h = hero.getBoundingClientRect(); return [h.left + h.width / 2, h.top + h.height * 0.52, Math.max(h.width * 0.42, 200), Math.max(h.height * 0.42, 90)]; },
    ignore: 'a, button, input, textarea, select, img, .composer, h1, .bar, [popover]',
  });
</script>
