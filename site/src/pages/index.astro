---
import Base from '../layouts/Base.astro';
import PageCrop from '../components/PageCrop.astro';
import Icon from '../components/Icon.astro';
import { allShelves, getDoc, getUnit, libraryCounts } from '../lib/data';
import { anchorLabel, citePath, clothOf, shelfName, shelfOrder, shortLabel } from '../lib/cite';
import { landingChecks } from '../lib/checks';
import { spanInUnit } from '../lib/quote';
import { mcpUrl } from '../lib/env';

// The example is checked by the server when the site is built: what is printed here is its answer.
const { verified, rejected } = await landingChecks();
const where = verified.locations[0];
const doc = getDoc(where.cite.split('/')[0])!;
const n = libraryCounts();
const num = (x: number) => x.toLocaleString('en');
const unit = getUnit(where.cite)!;
const label = `${shortLabel(doc)}, ${unit.anchor_label ?? anchorLabel(where.anchor)}`;
const found = spanInUnit(unit, [where.spine_start, where.spine_end])!;
// The example's page, shipped with the site (public/hero/, from scripts/hero.sh).
const HERO_PAGE = '/hero/page.webp';
const connect = `claude mcp add --transport http lectern ${mcpUrl(Astro.site!.origin)}`;
const shelves = [...allShelves()].sort((a, b) => shelfOrder(a.id) - shelfOrder(b.id));
const examples = ['"made man that we might be made God"', '"plurality of gods"', 'Melchizedek NEAR/10 priesthood', 'Logos NEAR/5 flesh'];
const years = shelves.flatMap((s) => s.years.map(([y]) => Number(y))).filter(Boolean);
const span = `${Math.min(...years)} to ${Math.max(...years)}`;
---
<Base find={false}>
  <section class="wrap hero" data-proof data-show="verified">
    <div class="hero-say">
      <h1 class="sr">Lectern</h1>
      <div class="hero-find">
        <form class="composer" action="/search" role="search" data-composer>
          <div class="cbox">
            <input type="search" name="query" placeholder={`Search ${num(n.documents)} books, ${num(n.pages)} pages`} aria-label="Search the library" autocomplete="off" />
            <button class="send" aria-label="Search"><Icon name="send" /></button>
          </div>
        </form>
        <p class="tries">{examples.map((q) => <a href={`/search?query=${encodeURIComponent(q)}`}>{q}</a>)}</p>
      </div>
      <div class="claims">
        <button class="claim" data-pick="verified" aria-pressed="true">
          <q>{verified.quote}</q>
          <span class="claim-foot">
            <span class="chip" data-state="verified"><span class="sr">Verified: </span><span class="chip-label">{label}</span></span>
            <span class="state" data-state="verified">On the page, word for word</span>
          </span>
        </button>
        <button class="claim" data-pick="rejected" aria-pressed="false">
          <q>{rejected.quote}</q>
          <span class="claim-foot">
            <span class="chip" data-state="rejected"><span class="sr">Rejected: </span><span class="chip-label">{label}</span></span>
            <span class="state" data-state="rejected">How it is usually quoted. Not on the page</span>
          </span>
        </button>
      </div>
    </div>
    <figure class="hero-page">
      <div data-pane="verified"><PageCrop unit={unit} ranges={[found]} src={HERO_PAGE} alt={`${doc.title}, ${anchorLabel(where.anchor)}, with the quoted words marked`} eager /></div>
      <div data-pane="rejected"><PageCrop unit={unit} ranges={[found]} src={HERO_PAGE} kind="reject" alt={`${doc.title}, ${anchorLabel(where.anchor)}, with the words Athanasius actually wrote underlined`} /></div>
      <figcaption class="caption"><span>{doc.title}, {anchorLabel(where.anchor)} of {num(doc.unit_count)}</span><a class="link" href={citePath(where.cite, verified.quote)}>Open the page</a></figcaption>
    </figure>
  </section>

  <div class="wrap">
    <section class="section" aria-labelledby="shelves-h">
      <h2 class="h2" id="shelves-h"><a href="/library">The shelves</a></h2>
      <div class="spines">
        {shelves.map((s) => (
          <a href={`/library/${s.id}`} style={`--cloth:${clothOf(s.id)};flex-grow:${Math.sqrt(s.docs.length).toFixed(2)}`}>
            <span class="name">{shelfName(s.id)}</span>
            <span class="val">{num(s.docs.length)}</span>
          </a>
        ))}
      </div>
      <p class="muted shelf-note">{num(n.documents)} books printed {span}, every one in the public domain, every page searchable, readable and citable.</p>
    </section>

    <section class="section split" aria-labelledby="agents-h">
      <div class="agent">
        <h2 class="h2" id="agents-h"><a href="/connect">Connect an AI</a></h2>
        <div class="codeline"><code tabindex="0">{connect}</code><button class="ib" data-copy={connect} aria-label="Copy command"><Icon name="copy" /></button></div>
        <p class="tries"><a href="/connect">search</a><a href="/connect">fetch</a><a href="/connect">verify_quote</a><a href="/connect">check_answer</a></p>
      </div>
      <div class="rooms">
        <a href="/check?example=1">
          <h2 class="h2">Check a quotation</h2>
          <span class="sub">Paste an answer with its citations. Each quotation is checked against the page it names.</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<script>
  const composer = document.querySelector<HTMLFormElement>('[data-composer]')!;
  composer.addEventListener('input', () => composer.toggleAttribute('data-typed', !!composer.querySelector('input')!.value.trim()));
  const proof = document.querySelector<HTMLElement>('[data-proof]')!;
  proof.querySelectorAll<HTMLElement>('[data-pick]').forEach((claim) =>
    claim.addEventListener('click', () => {
      proof.dataset.show = claim.dataset.pick;
      proof.querySelectorAll('[data-pick]').forEach((c) => c.setAttribute('aria-pressed', String(c === claim)));
    }),
  );
</script>
